{
  "name": "@bjorntech/betterauth-dynamodb",
  "version": "1.1.0",
  "description": "Production-oriented Better Auth DynamoDB adapter",
  "keywords": [
    "better-auth",
    "dynamodb",
    "adapter",
    "aws"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjorntech/betterauth-dynamodb.git"
  },
  "homepage": "https://github.com/bjorntech/betterauth-dynamodb#readme",
  "readmeFilename": "README.md",
  "bugs": {
    "url": "https://github.com/bjorntech/betterauth-dynamodb/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration:local": "vitest run --config vitest.integration.config.ts",
    "dynamo:local": "dynoxide serve --host 127.0.0.1",
    "build": "tsc -p tsconfig.build.json",
    "quality:crap": "bun scripts/crap-check.ts coverage/lcov.info src",
    "smoke:dist-import": "bun run build && node scripts/dist-import-smoke.mjs",
    "verify": "bun run typecheck && bun run lint && bun run test:coverage && bun run quality:crap && bun run build",
    "verify:integration": "bun run test:integration:local",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "better-auth": "^1.6.25"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.758.0",
    "@aws-sdk/lib-dynamodb": "^3.758.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@better-auth/core": "1.7.5",
    "@better-auth/oauth-provider": "1.7.5",
    "@better-auth/test-utils": "1.7.5",
    "@types/babel__traverse": "^7.20.7",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "better-auth": "1.7.5",
    "dynoxide": "1.3.0",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "bun@1.2.5"
}
